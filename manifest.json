{
  "id": "./",
  "name": "ReadPlanner",
  "short_name": "ReadPlanner",
  "description": "A publisher-faithful EPUB reader with adjustable typography, continuous reading, plans, highlights, vocabulary and read-aloud.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#F8F7F4",
  "theme_color": "#1F2A24",
  "categories": [
    "books",
    "education",
    "productivity"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icons/icon-192-v80.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512-v80.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192-maskable-v80.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon-512-maskable-v80.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Continue reading",
      "short_name": "Continue",
      "url": "./?shortcut=continue",
      "icons": [
        {
          "src": "./icons/icon-192-v80.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Review vocabulary",
      "short_name": "Vocabulary",
      "url": "./?shortcut=vocab",
      "icons": [
        {
          "src": "./icons/icon-192-v80.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./?share-target=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "book",
          "accept": [
            "application/epub+zip",
            "application/pdf",
            "text/plain",
            ".epub",
            ".pdf",
            ".txt"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./?file-handler=1",
      "accept": {
        "application/epub+zip": [
          ".epub"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "text/plain": [
          ".txt"
        ]
      }
    }
  ]
}
